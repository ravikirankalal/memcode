{
  "name": "memcode",
  "version": "0.12.0",
  "description": "A memory agent beside Claude Code: it extracts what is worth remembering, keeps it true, and delivers it when it matters.",
  "mcpServers": {
    "memcode": {
      "command": "python3",
      "args": [
        "-m",
        "memcode.mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  },
  "author": {
    "name": "Ravikiran Kalal"
  },
  "homepage": "https://github.com/ravikirankalal/memcode",
  "repository": "https://github.com/ravikirankalal/memcode",
  "license": "MIT",
  "keywords": [
    "memory",
    "coding-agent",
    "hooks",
    "mcp"
  ]
}
