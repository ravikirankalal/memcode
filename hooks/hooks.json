{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "timeout": 30, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/memcode\" hook SessionStart"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/memcode\" hook UserPromptSubmit"}]}],
    "PreToolUse": [{"matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/memcode\" hook PreToolUse"}]}],
    "PostToolUse": [{"matcher": "Bash|Edit|Write|MultiEdit|Read", "hooks": [{"type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/memcode\" hook PostToolUse"}]}],
    "Stop": [{"hooks": [{"type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/memcode\" hook Stop"}]}],
    "PostToolUseFailure": [{"matcher": "Bash", "hooks": [{"type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/memcode\" hook PostToolUseFailure"}]}]
  }
}
